# Environment configuration for Healthcare Cloud Simulation
# Production-like simulated environment

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=healthcare_prod_secret_vault_pw
POSTGRES_DB=healthcare
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Microservice URLs
AI_SERVICE_URL=http://ai-service:8082
EHR_SERVICE_URL=http://mock-ehr:8083

# Failure Simulation Defaults
EHR_MODE=normal
APP_VERSION=v1.0.0
DEPLOYMENT_COLOR=blue

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_pass
